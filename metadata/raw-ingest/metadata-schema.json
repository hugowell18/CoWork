{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "data-weight-control.raw-ingest.metadata.schema.json",
  "title": "Raw Ingest Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "dataset",
    "ingest_run_id",
    "fetch_time",
    "trade_date_range",
    "usable_scope",
    "request",
    "files"
  ],
  "properties": {
    "source": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "dataset": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "ingest_run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "fetch_time": {
      "type": "string",
      "format": "date-time"
    },
    "trade_date_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "usable_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "valid_from", "valid_to", "reason", "allowed_consumers"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["provisional", "validated", "corrected", "rejected"]
        },
        "valid_from": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "valid_to": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "reason": {
          "type": "string"
        },
        "allowed_consumers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["clean", "audit", "debug"]
          },
          "uniqueItems": true
        }
      }
    },
    "request": {
      "type": "object"
    },
    "correction_of": {
      "type": "string"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role"],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": ["payload", "metadata"]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    }
  }
}
