{
  "dataset": "daily_basic",
  "category": "market-fundamental",
  "logical_key": ["ts_code", "trade_date"],
  "date_column": "trade_date",
  "partition": {
    "type": "month",
    "column": "trade_date",
    "format": "YYYY-MM"
  },
  "sort_order": ["ts_code", "trade_date"],
  "dedup": {
    "mode": "last-write-wins",
    "order_by": ["fetch_time", "ingest_run_id"],
    "on_unresolved_tie": "block"
  },
  "usable_scope": {
    "allowed_values": ["provisional", "validated", "corrected", "rejected"],
    "default": "provisional",
    "clean_allowed": ["validated", "corrected"]
  },
  "hot_layer": {
    "mode": "external-only",
    "reason": "daily_basic is a governance candidate and can be queried through DuckDB external Parquet views"
  },
  "storage": {
    "raw_path": "data/raw/daily_basic",
    "clean_path": "data/clean/daily_basic",
    "mart_path": "data/marts/daily_basic/window=external-only"
  },
  "small_file": {
    "max_files_per_month": 4,
    "min_average_file_mb": 32
  },
  "strategy_risks": ["factor-input", "long-lookback"],
  "migration": {
    "candidate": true,
    "candidate_reason": "first-priority DuckDB external Parquet view candidate",
    "requires_human_approval_to_drop": true
  }
}
